// Transit survival sidecar override for the cosmodrome custom-map carrier.
// This FF loads after the base map and is the safest place to override the
// transit script surface without duplicating world assets.
>game,T6
>name,so_zsurvival_zm_transit

rawfile,maps/mp/zm_transit.gsc
rawfile,maps/mp/zm_cosmodrome_standard.gsc
rawfile,maps/mp/gametypes_zm/_zm_gametype.gsc
rawfile,clientscripts/mp/zm_transit.csc

script,maps/mp/zm_transit.gsc
script,maps/mp/zm_cosmodrome_standard.gsc
script,maps/mp/gametypes_zm/_zm_gametype.gsc
script,clientscripts/mp/zm_transit.csc
